# ============================================================
# ai-script deploy environment example
# Copy to deploy/.env and fill in real values before `docker compose up`
# ============================================================

# ---- App ----
APP_ENV=prod
APP_PORT=8080
APP_LOG_LEVEL=info

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=ai_script
MYSQL_USER=ai_script
MYSQL_PASSWORD=ai_script123
MYSQL_PORT=3306
MYSQL_MAX_IDLE=10
MYSQL_MAX_OPEN=100
MYSQL_CONN_MAX_LIFETIME=3600
MYSQL_CONN_MAX_IDLE_TIME=1800

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_TIMEOUT=5

# ---- MinIO (S3-compatible) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OSS_PROVIDER=minio
OSS_ENDPOINT=http://minio:9000
OSS_REGION=us-east-1
OSS_BUCKET=ai-script
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin
OSS_PUBLIC_HOST=http://localhost:9000/ai-script

# ---- JWT ----
JWT_SECRET=please-change-me-in-prod
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

# ---- Crypto (AES key) ----
# 方式1: 直接提供 32 字节明文密钥 (优先)
CRYPTO_KEY=
# 方式2: base64 编码的 32 字节密钥
CRYPTO_KEY_BASE64=Z3JhZGUtMzItYnl0ZS1leGFtcGxlLWtleS1iYXNlNjQtcGxlYXNlLWNoYW5nZQ==

# ---- Model gateway ----
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=

# ---- Server / Worker ----
SERVER_PORT=8080
CONFIG_FILE=/app/configs/config.yaml
