# ============================================================
# ai-script local docker-compose environment example
# Copy to .env and fill in real values before `docker compose up`
# ============================================================

# ---- App ----
APP_ENV=local
APP_PORT=8080
APP_LOG_LEVEL=debug

# ---- MySQL ----
MYSQL_ROOT_PWD=root_pwd_change_me
MYSQL_DATABASE=ai_script
MYSQL_USER=ai_script
MYSQL_PASSWORD=ai_script_pwd
MYSQL_PORT=3306
MYSQL_DSN=ai_script:ai_script_pwd@tcp(mysql:3306)/ai_script?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_MAX_IDLE=10
MYSQL_MAX_OPEN=100

# ---- Redis ----
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MinIO (S3-compatible) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OSS_PROVIDER=minio
OSS_ENDPOINT=http://minio:9000
OSS_REGION=us-east-1
OSS_BUCKET=ai-script
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin
OSS_PUBLIC_HOST=http://localhost:9000/ai-script

# ---- JWT ----
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

# ---- Crypto (AES key, 32 bytes) ----
CRYPTO_KEY=CHANGE_ME_TO_RANDOM_32_BYTES

# ---- Model gateway ----
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=

# ---- Server / Worker ----
SERVER_PORT=8080
CONFIG_FILE=/app/configs/config.local.yaml
