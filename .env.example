# ai-script environment template
# Copy to .env and fill in real values before local run or docker compose.

# ---- App ----
APP_NAME=ai-script
APP_ENV=local # local / dev / prod
APP_PORT=8080
APP_LOG_LEVEL=debug # debug / info / warn / error
APP_ORIGINS=http://localhost # production should use real frontend domains, comma-separated

# ---- Backend runtime ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ai_script
MYSQL_PASSWORD=ai_script_pwd
MYSQL_DATABASE=ai_script
MYSQL_CHARSET=utf8mb4
MYSQL_PARSE_TIME=true
MYSQL_MULTI_STATEMENTS=false
MYSQL_MAX_IDLE=10
MYSQL_MAX_OPEN=100
MYSQL_CONN_MAX_LIFETIME=3600
MYSQL_CONN_MAX_IDLE_TIME=1800

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_TIMEOUT=5

# local: Docker 用 /data/uploads（compose 已挂载卷）；本地 go run 用 ./var/uploads
OSS_PROVIDER=local
OSS_ENDPOINT=http://minio:9000
OSS_REGION=us-east-1
OSS_BUCKET=/data/uploads
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin
OSS_PUBLIC_HOST=/uploads

JWT_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES_MIN # at least 32 chars
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

CRYPTO_KEY_BASE64=CHANGE_ME_TO_BASE64_OF_32_RANDOM_BYTES # base64 of 32 random bytes

MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=

QUEUE_CONCURRENCY=16
MIGRATE_MODE=auto
MIGRATE_SOURCE=
MIGRATE_DSN=

# ---- Local compose only ----
MYSQL_ROOT_PASSWORD=root_pwd_change_me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

SERVER_PORT=8080
FRONTEND_PORT=80

SEED_ADMIN_PASSWORD=123456
