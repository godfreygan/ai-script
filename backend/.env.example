# Application
APP_NAME=ai-script
APP_ENV=dev
APP_PORT=8080
APP_LOG_LEVEL=info

# JWT
JWT_SECRET=please-change-me-in-prod
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

# MySQL
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/ai_script?charset=utf8mb4&parseTime=True&loc=UTC&time_zone=%27%2B00%3A00%27
MYSQL_MAX_IDLE=10
MYSQL_MAX_OPEN=100

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (兼容 S3 / 阿里云 OSS / 腾讯云 COS)
OSS_PROVIDER=aliyun
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=ai-script
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_PUBLIC_HOST=https://ai-script.oss-cn-hangzhou.aliyuncs.com

# Encryption key for model api-keys (AES-256-GCM, base64 of 32 random bytes)
# 生成方式:`go run ./cmd/genkey`
CRYPTO_KEY=Aix2XN/944vtHhBM5bd2Ibv5SQTCgZ/GwHheRVlwyiQ=

# AI 模型网关(可选,推荐用 one-api / litellm)
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=
