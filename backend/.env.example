# AI Script Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# JWT — must be >= 32 chars random string
JWT_SECRET=change-me-to-a-real-random-string-at-least-32-chars

# MySQL DSN format: user:password@tcp(host:port)/dbname?params
MYSQL_DSN=aiscript:your_password@tcp(127.0.0.1:3306)/ai_script?charset=utf8mb4&parseTime=True&loc=UTC

# Redis
REDIS_PASSWORD=your_redis_password

# Crypto — AES-256 需要恰好 32 字节
# 二选一:
#   方式 A(推荐): CRYPTO_KEY_BASE64 — 填 base64 编码的密钥,程序自动解码
#                 生成命令: go run ./cmd/genkey
#   方式 B: CRYPTO_KEY — 直接填 32 字节原始字符串(不要填 base64,否则长度会报 44)
CRYPTO_KEY_BASE64=
# CRYPTO_KEY=your-32-byte-crypto-key-here!!

# Model Gateway (e.g., LiteLLM / One-API)
MODEL_GATEWAY_URL=https://your-gateway.example.com/v1
MODEL_GATEWAY_KEY=your-gateway-api-key

# Object Storage (optional — defaults to local filesystem)
# OSS_PROVIDER=local
# OSS_ENDPOINT=
# OSS_REGION=
# OSS_BUCKET=./var/uploads
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_PUBLIC_HOST=/uploads
